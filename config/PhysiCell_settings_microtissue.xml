<PhysiCell_settings version="devel-version">

    <domain>
        <x_min>-400</x_min>
        <x_max>400</x_max>
        <y_min>-400</y_min>
        <y_max>400</y_max>
        <z_min>-400</z_min>
        <z_max>400</z_max>
        <dx>10</dx>
        <dy>10</dy>
        <dz>10</dz>
        <use_2D>false</use_2D>
    </domain>

    <overall>
        <max_time units="min">300</max_time>
        <time_units>sec</time_units>
        <space_units>micron</space_units>
        <dt_diffusion units="min">0.1</dt_diffusion>
        <dt_mechanics units="min">0.1</dt_mechanics>
        <dt_phenotype units="min">0.1</dt_phenotype>
    </overall>

    <parallel>
        <omp_num_threads>14</omp_num_threads>
    </parallel>

    <save>
        <folder>output</folder>
        <full_data>
            <interval units="sec">1</interval>
            <enable>false</enable>
        </full_data>
        <SVG>
            <interval units="sec">1</interval>
            <enable>true</enable>
            <plot_substrate enabled="true" limits="false">
                <substrate>EG</substrate>
                <min_conc />
                <max_conc />
                <colormap>YlOrRd</colormap>
            </plot_substrate>
        </SVG>
        <legacy_data>
            <enable>false</enable>
        </legacy_data>
    </save>

    <options>
        <legacy_random_points_on_sphere_in_divide>false</legacy_random_points_on_sphere_in_divide>
        <virtual_wall_at_domain_edge>true</virtual_wall_at_domain_edge>
        <disable_automated_spring_adhesions>true</disable_automated_spring_adhesions>
        <random_seed>1</random_seed>
    </options>

    <microenvironment_setup>
        <variable name="NaCl" units="dimensionless" ID="0">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">510</diffusion_coefficient>
                <decay_rate units="1/min">0</decay_rate>
            </physical_parameter_set>
            <initial_condition units="fmol/um^3">0.151</initial_condition>
            <Dirichlet_boundary_condition units="fmol/um^3" enabled="True">0.151</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="True">0</boundary_value>
                <boundary_value ID="xmax" enabled="True">0</boundary_value>
                <boundary_value ID="ymin" enabled="True">0</boundary_value>
                <boundary_value ID="ymax" enabled="True">0</boundary_value>
                <boundary_value ID="zmin" enabled="True">0</boundary_value>
                <boundary_value ID="zmax" enabled="True">0</boundary_value>
            </Dirichlet_options>
        </variable>
        <variable name="EG" units="dimensionless" ID="1">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">510</diffusion_coefficient>
                <decay_rate units="1/min">0</decay_rate>
            </physical_parameter_set>
            <initial_condition units="fmol/um^3">1.819</initial_condition>
            <Dirichlet_boundary_condition units="fmol/um^3" enabled="True">1.819</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="True">0</boundary_value>
                <boundary_value ID="xmax" enabled="True">0</boundary_value>
                <boundary_value ID="ymin" enabled="True">0</boundary_value>
                <boundary_value ID="ymax" enabled="True">0</boundary_value>
                <boundary_value ID="zmin" enabled="True">0</boundary_value>
                <boundary_value ID="zmax" enabled="True">0</boundary_value>
            </Dirichlet_options>
        </variable>
        <variable name="contractility_signaling" units="dimensionless" ID="2">
            <physical_parameter_set>
                <diffusion_coefficient units="micron^2/min">10.0</diffusion_coefficient>
                <decay_rate units="1/min">2.0</decay_rate>
            </physical_parameter_set>
            <initial_condition units="dimensionless">0.0</initial_condition>
            <Dirichlet_boundary_condition units="dimensionless" enabled="False">0.0</Dirichlet_boundary_condition>
            <Dirichlet_options>
                <boundary_value ID="xmin" enabled="False" />
                <boundary_value ID="xmax" enabled="False" />
                <boundary_value ID="ymin" enabled="False" />
                <boundary_value ID="ymax" enabled="False" />
                <boundary_value ID="zmin" enabled="False" />
                <boundary_value ID="zmax" enabled="False" />
            </Dirichlet_options>
        </variable>
        <options>
            <calculate_gradients>true</calculate_gradients>
            <track_internalized_substrates_in_each_agent>false</track_internalized_substrates_in_each_agent>
            <initial_condition type="csv" enabled="false">
                <filename>./config/ics.csv</filename>
            </initial_condition>
            <dirichlet_nodes type="matlab" enabled="false">
                <filename>./config/dirichlet.mat</filename>
            </dirichlet_nodes>
        </options>
    </microenvironment_setup>

    <cell_definitions>
